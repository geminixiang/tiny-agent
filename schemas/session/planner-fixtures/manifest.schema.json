{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tiny-agent.local/schemas/session/planner-fixtures/manifest.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "fixtures"],
    "properties": {
        "version": { "const": 1 },
        "fixtures": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "input", "expected"],
                "properties": {
                    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                    "input": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
                    "expected": { "type": "string", "pattern": "^[a-z0-9-]+\\.expected\\.json$" }
                }
            }
        }
    }
}
