{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tiny-agent.local/schemas/session/recovery-plan.schema.json",
    "oneOf": [
        { "$ref": "#/$defs/finish" },
        { "$ref": "#/$defs/startStep" },
        { "$ref": "#/$defs/startTool" },
        { "$ref": "#/$defs/appendSynthetic" },
        { "$ref": "#/$defs/closeAttempt" },
        { "$ref": "#/$defs/blocked" }
    ],
    "$defs": {
        "finish": { "type": "object", "required": ["type", "outcome"], "properties": { "type": { "const": "finish" }, "outcome": { "enum": ["completed", "aborted", "failed"] }, "completion": { "enum": ["normal", "truncated"] }, "finalEntryId": { "type": "string" }, "error": { "type": "object" } }, "additionalProperties": false },
        "startStep": { "type": "object", "required": ["type", "stepKind", "attempt", "contextThroughEntryId"], "properties": { "type": { "const": "startStep" }, "stepKind": { "enum": ["assistant", "compaction"] }, "attempt": { "enum": [1, 2] }, "stepId": { "type": "string" }, "contextThroughEntryId": { "type": "string" } }, "additionalProperties": false },
        "startTool": { "type": "object", "required": ["type", "mode", "assistantEntryId", "toolIndex", "toolName", "arguments"], "properties": { "type": { "const": "startTool" }, "mode": { "enum": ["start", "replay"] }, "assistantEntryId": { "type": "string" }, "toolIndex": { "type": "integer", "minimum": 0 }, "toolStartedId": { "type": "string" }, "toolName": { "type": "string" }, "arguments": { "type": "object" } }, "additionalProperties": false },
        "appendSynthetic": { "type": "object", "required": ["type", "results"], "properties": { "type": { "const": "appendSynthetic" }, "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/synthetic" } } }, "additionalProperties": false },
        "preExecutionSynthetic": {
            "type": "object",
            "required": ["assistantEntryId", "toolIndex", "toolCallId", "toolName", "reason", "content"],
            "properties": {
                "assistantEntryId": { "type": "string" },
                "toolIndex": { "type": "integer", "minimum": 0 },
                "toolCallId": { "type": "string" },
                "toolName": { "type": "string" },
                "reason": { "enum": ["invalidArguments", "unknownTool", "truncated", "aborted"] },
                "content": { "type": "string" }
            },
            "additionalProperties": false
        },
        "interruptedSynthetic": {
            "type": "object",
            "required": ["assistantEntryId", "toolIndex", "toolCallId", "toolName", "toolStartedId", "resultEntryId", "reason", "content"],
            "properties": {
                "assistantEntryId": { "type": "string" },
                "toolIndex": { "type": "integer", "minimum": 0 },
                "toolCallId": { "type": "string" },
                "toolName": { "type": "string" },
                "toolStartedId": { "type": "string" },
                "resultEntryId": { "type": "string" },
                "reason": { "const": "interrupted" },
                "content": { "type": "string" }
            },
            "additionalProperties": false
        },
        "synthetic": { "oneOf": [{ "$ref": "#/$defs/preExecutionSynthetic" }, { "$ref": "#/$defs/interruptedSynthetic" }] },
        "closeAttempt": { "type": "object", "required": ["type", "error"], "properties": { "type": { "const": "closeAttempt" }, "error": { "type": "object" } }, "additionalProperties": false },
        "blocked": { "type": "object", "required": ["type", "reason"], "properties": { "type": { "const": "blocked" }, "reason": { "enum": ["configuration_changed", "environment_changed", "replay_declaration_changed", "attempts_exhausted"] } }, "additionalProperties": false }
    }
}
