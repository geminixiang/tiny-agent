{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiny-agent.local/schemas/session.schema.json",
  "title": "tiny-agent JSONL session record",
  "description": "Each line in .tiny-agent/sessions/*.jsonl MUST independently validate against this schema. The first line MUST be a session record; remaining lines are chronological message, compaction, or interruption records.",
  "oneOf": [
    { "$ref": "#/$defs/session" },
    { "$ref": "#/$defs/messageRecord" },
    { "$ref": "#/$defs/compaction" },
    { "$ref": "#/$defs/interruption" }
  ],
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cacheRead", "cacheWrite"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cacheRead": { "type": "integer", "minimum": 0 },
        "cacheWrite": { "type": "integer", "minimum": 0 }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "function"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "function" },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "arguments"],
          "properties": {
            "name": { "enum": ["bash", "read", "write", "edit"] },
            "arguments": { "type": "string", "description": "JSON-encoded tool arguments as returned by OpenRouter." }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["user", "assistant", "tool"] },
        "content": { "type": ["string", "null"] },
        "tool_call_id": { "type": "string" },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "tool" } }, "required": ["role"] },
          "then": { "required": ["tool_call_id"] }
        }
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "id", "createdAt", "timestamp", "cwd", "provider", "model"],
      "properties": {
        "type": { "const": "session" },
        "version": { "const": 1 },
        "id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "cwd": { "type": "string" },
        "provider": { "const": "openrouter" },
        "model": { "type": "string" }
      }
    },
    "messageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timestamp", "message"],
      "properties": {
        "type": { "const": "message" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "message": { "$ref": "#/$defs/message" },
        "usage": { "$ref": "#/$defs/usage" },
        "toolName": { "enum": ["bash", "read", "write", "edit"] }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timestamp", "summary", "compactedMessages", "keptMessages", "usage"],
      "properties": {
        "type": { "const": "compaction" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "summary": { "type": ["string", "null"] },
        "compactedMessages": { "type": "integer", "minimum": 1 },
        "keptMessages": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timestamp", "phase", "reason"],
      "properties": {
        "type": { "const": "interruption" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "phase": { "enum": ["model", "tool", "compact"] },
        "reason": { "const": "escape" },
        "toolCallId": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "phase": { "const": "tool" } }, "required": ["phase"] },
          "then": { "required": ["toolCallId"] }
        }
      ]
    }
  }
}
